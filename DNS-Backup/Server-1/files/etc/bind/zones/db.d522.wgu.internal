$TTL    86400
@   IN  SOA ns1.d522.wgu.internal. admin.d522.wgu.internal. (
        2026040301 ; Serial
        3600       ; Refresh
        900        ; Retry
        604800     ; Expire
        86400 )    ; Minimum TTL

; Name servers
@       IN  NS      ns1.d522.wgu.internal.
@       IN  NS      ns2.d522.wgu.internal.

; A records
ns1      IN  A       10.10.10.10
ns2      IN  A       10.10.10.20
api      IN  A       10.10.10.200
db       IN  A       10.10.10.210
smtp     IN  A       10.10.10.100
mail     IN  A       10.10.10.100
inbox    IN  A       10.10.10.100
helpdesk IN  A       10.10.10.200
svr1     IN  A       192.168.20.210
svr2     IN  A       192.168.30.210
